{
	"name": "plaintext-diagrams",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"lint": "biome ci .",
		"lint:fix": "biome check --write .",
		"preview": "vite preview",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.9",
		"@playwright/test": "^1.62.1",
		"@types/node": "^26.2.0",
		"typescript": "^5.5.4",
		"vite": "^5.4.8",
		"vitest": "^2.1.1"
	},
	"dependencies": {
		"@dagrejs/dagre": "^3.1.1",
		"@fontsource/atkinson-hyperlegible-mono": "^5.3.0"
	}
}
